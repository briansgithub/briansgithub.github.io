---
import { Image } from 'astro:assets';
import '../styles/global.css';
import { navigation, site } from '../data/site';
import brandMark from '../assets/images/brand/be-monogram.webp';

interface Props {
	title?: string;
	description?: string;
	placeholder?: boolean;
}

const { title = site.title, description = site.description, placeholder = false } = Astro.props;
const pageTitle = title === site.title ? title : `${title} — ${site.name}`;
const canonical = new URL(Astro.url.pathname, site.url);
const noIndex = site.preview || placeholder;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#0b0e14" />
		{noIndex && <meta name="robots" content="noindex, nofollow" />}
		<link rel="canonical" href={canonical} />
		<link
			rel="preload"
			href="/fonts/ibm-plex-sans-latin-400-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link
			rel="preload"
			href="/fonts/ibm-plex-sans-latin-500-normal.woff2"
			as="font"
			type="font/woff2"
			crossorigin
		/>
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="apple-touch-icon" href={brandMark.src} />
		<link rel="alternate" type="application/rss+xml" title={site.title} href="/rss.xml" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta name="twitter:card" content="summary" />
		<title>{pageTitle}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<header class="site-header">
			<div class="shell site-header__inner">
				<div class="site-brand">
					<a class="site-brand__mark-link" href="/" aria-label={`${site.name}, home`}>
						<Image
							class="site-brand__mark"
							src={brandMark}
							alt=""
							width={256}
							height={256}
							loading="eager"
						/>
					</a>
					<span class="site-brand__copy">
						<a class="site-brand__name" href="/">{site.name}</a>
						<span class="site-brand__tagline">{site.tagline}</span>
					</span>
				</div>
				<nav id="primary-nav" aria-label="Primary navigation">
					<ul class="primary-nav__list">
						{
							navigation.map((item) => {
								const exact = Astro.url.pathname === item.href;
								const childRoute =
									(item.href !== '/' && Astro.url.pathname.startsWith(item.href)) ||
									('matchPrefixes' in item &&
										item.matchPrefixes.some((prefix) => Astro.url.pathname.startsWith(prefix)));
								const current = exact ? 'page' : childRoute ? 'location' : undefined;
								return (
									<li>
										<a href={item.href} aria-current={current}>
											{item.label}
										</a>
									</li>
								);
							})
						}
					</ul>
					<ul class="primary-nav__utility" aria-label="Contact and subscription">
						<li><a href={`mailto:${site.email}`}>Email</a></li>
						<li><a href="/rss.xml">RSS feed</a></li>
					</ul>
				</nav>
				<div class="site-header__links" aria-label="Social and contact links">
					<a
						class="site-header__link--secondary"
						href={`mailto:${site.email}`}
						aria-label={`Email ${site.name}`}
					>
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<rect x="3" y="5" width="18" height="14" rx="2"></rect>
							<path d="m3 7 9 6 9-6"></path>
						</svg>
					</a>
					<a href={site.github} rel="me" aria-label="GitHub">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path
								d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"
							></path>
						</svg>
					</a>
					{
						site.linkedin && (
							<a href={site.linkedin} rel="me" aria-label="LinkedIn">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
									<rect x="2" y="9" width="4" height="12" />
									<circle cx="4" cy="4" r="2" />
								</svg>
							</a>
						)
					}
					{
						site.instagram && (
							<a href={site.instagram} rel="me" aria-label="Instagram">
								<svg
									viewBox="0 0 24 24"
									fill="none"
									stroke="currentColor"
									stroke-width="2"
									stroke-linecap="round"
									stroke-linejoin="round"
									aria-hidden="true"
								>
									<rect x="2" y="2" width="20" height="20" rx="5" ry="5" />
									<path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z" />
									<line x1="17.5" y1="6.5" x2="17.5" y2="6.5" />
								</svg>
							</a>
						)
					}
					<a class="site-header__link--secondary" href="/rss.xml" aria-label="RSS Feed">
						<svg
							viewBox="0 0 24 24"
							fill="none"
							stroke="currentColor"
							stroke-width="2"
							stroke-linecap="round"
							stroke-linejoin="round"
							aria-hidden="true"
						>
							<path d="M4 11a9 9 0 0 1 9 9"></path>
							<path d="M4 4a16 16 0 0 1 16 16"></path>
							<circle cx="5" cy="19" r="1" fill="currentColor" stroke="none"></circle>
						</svg>
					</a>
				</div>
			</div>
		</header>
		<main id="main-content">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="shell site-footer__inner">
				<p>
					<span>A running log of builds, notes, and work in progress.</span>
					<span aria-hidden="true"> · </span>
					{site.preview && <span class="preview-badge">Preview</span>}
					{' '}
					© {new Date().getFullYear()}
					{' '}
					{site.name}
				</p>
				<p class="site-footer__disclaimer">
					Sol 5.6 and Opus 5 used to generate website design. No AI was used for generating
					text-based content; all writing is my own.
				</p>
			</div>
		</footer>
	</body>
</html>
