---
import PlaceholderBadge from './PlaceholderBadge.astro';

interface Props {
	href: string;
	title: string;
	description: string;
	meta?: string;
	tags?: string[];
	tagLabel?: string;
	headingLevel?: 2 | 3;
	placeholder?: boolean;
}

const {
	href,
	title,
	description,
	meta,
	tags = [],
	tagLabel = 'Topics',
	headingLevel = 2,
	placeholder = false,
} = Astro.props;
const cardId = href.replace(/[^a-z0-9]+/gi, '-').replace(/(^-|-$)/g, '');
const titleId = `${cardId}-title`;
const descriptionId = `${cardId}-description`;
---

<article class="content-card">
	<a
		class="content-card__link"
		href={href}
		aria-labelledby={titleId}
		aria-describedby={descriptionId}
	>
		<div class="content-card__topline">
			{meta && <span>{meta}</span>}
			{placeholder && <PlaceholderBadge label="Sample" />}
		</div>
		{headingLevel === 2 ? <h2 id={titleId}>{title}</h2> : <h3 id={titleId}>{title}</h3>}
		<p id={descriptionId}>{description}</p>
		{
			tags.length > 0 && (
				<ul class="card-chip-list" aria-label={tagLabel}>
					{tags.map((tag) => (
						<li>{tag}</li>
					))}
				</ul>
			)
		}
		<span class="content-card__arrow" aria-hidden="true">→</span>
	</a>
</article>
