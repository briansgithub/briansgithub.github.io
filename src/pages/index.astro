---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import ActionLinks from '../components/ActionLinks.astro';
import ContentCard from '../components/ContentCard.astro';
import { site } from '../data/site';
import { contentSlug, formatDate, isVisible } from '../utils/content';
import portrait from '../assets/images/portrait/brian-ellsworth-portrait.webp';

const [writing, projects, books] = await Promise.all([
	getCollection('writing', ({ data }) => isVisible(data)),
	getCollection('projects', ({ data }) => isVisible(data)),
	getCollection('books', ({ data }) => isVisible(data)),
]);

const featuredWriting = writing
	.sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf())
	.slice(0, 2);
const featuredProjects = projects
	.sort(
		(a, b) =>
			Number(b.data.featured) - Number(a.data.featured) ||
			(a.data.order ?? 99) - (b.data.order ?? 99),
	)
	.slice(0, 2);
const latestBook = books.sort(
	(a, b) => (b.data.finishedAt?.valueOf() ?? 0) - (a.data.finishedAt?.valueOf() ?? 0),
)[0];
---

<BaseLayout>
	<section class="shell hero">
		<div class="hero__main">
			<p class="eyebrow">Build log / selected work</p>
			<h1>{site.name}</h1>
			<p class="hero__tagline">{site.tagline}</p>
			<ActionLinks
				label="Featured links"
				actions={[
					{ label: 'View projects', href: '/projects/', variant: 'primary' },
					{
						label: 'Download résumé',
						href: '/files/brian-ellsworth-resume.pdf',
						download: true,
					},
				]}
			/>
		</div>
		<aside class="hero__aside" aria-label="About Brian Ellsworth">
			<Image
				class="portrait-placeholder"
				src={portrait}
				alt="Brian Ellsworth smiling, wearing glasses"
				widths={[320, 480, 640]}
				sizes="17rem"
				loading="eager"
				fetchpriority="high"
			/>
			<a class="hero__about" href="/about/">About Brian <span aria-hidden="true">→</span></a>
		</aside>
	</section>

	{
		featuredProjects.length > 0 && (
			<section class="shell home-section" aria-labelledby="projects-heading">
				<div class="section-heading">
					<h2 id="projects-heading">Selected projects</h2>
					<a href="/projects/">All projects</a>
				</div>
				<div class="content-grid">
					{featuredProjects.map((project) => (
						<ContentCard
							href={`/projects/${contentSlug(project.id)}/`}
							title={project.data.title}
							description={project.data.summary}
							meta={`${project.data.year} · ${project.data.status}`}
							tags={project.data.technologies}
							placeholder={project.data.placeholder}
						/>
					))}
				</div>
			</section>
		)
	}

	{
		featuredWriting.length > 0 && (
			<section class="shell home-section" aria-labelledby="writing-heading">
				<div class="section-heading">
					<h2 id="writing-heading">Recent writing</h2>
					<a href="/writing/">All writing</a>
				</div>
				<div class="content-grid">
					{featuredWriting.map((entry) => (
						<ContentCard
							href={`/writing/${contentSlug(entry.id)}/`}
							title={entry.data.title}
							description={entry.data.description}
							meta={formatDate(entry.data.publishedAt)}
							tags={entry.data.tags}
							placeholder={entry.data.placeholder}
						/>
					))}
				</div>
			</section>
		)
	}

	<section class="shell closing-grid">
		<div>
			<p class="eyebrow">Reading log</p>
			{
				latestBook ? (
					<>
						<h2>{latestBook.data.title}</h2>
						<p>{latestBook.data.summary}</p>
						<a href={`/books/${contentSlug(latestBook.id)}/`}>Read the note →</a>
					</>
				) : (
					<p class="empty-state">Your first book note will appear here.</p>
				)
			}
		</div>
		<div>
			<p class="eyebrow">Elsewhere</p>
			<h2>Code, experiments, and unfinished things.</h2>
			<p>Source code and smaller experiments live on GitHub.</p>
			<a href={site.github}>Visit GitHub →</a>
		</div>
	</section>
</BaseLayout>

<style>
	.hero {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.55fr);
		gap: clamp(2.5rem, 6vw, 6rem);
		align-items: center;
		padding-block: clamp(3.5rem, 6vw, 5.5rem);
	}

	.hero__main {
		padding-block: 1rem;
	}

	.hero__tagline {
		max-width: 30ch;
		margin: 1.5rem 0 0;
		color: var(--ink-soft);
		font-family: var(--sans);
		font-size: clamp(1.15rem, 2vw, 1.5rem);
		line-height: 1.45;
	}

	.hero__aside {
		width: min(100%, 17rem);
		justify-self: end;
	}

	.hero__about,
	.closing-grid a {
		color: var(--accent);
		font-size: 0.82rem;
		font-weight: 500;
	}

	.hero__about {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		min-height: 2.75rem;
		margin-top: 0.5rem;
	}

	.portrait-placeholder {
		width: 100%;
		aspect-ratio: 4 / 5;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		object-fit: cover;
		object-position: 50% 38%;
	}

	.home-section {
		padding-top: 1rem;
	}

	.closing-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		margin-block: clamp(5rem, 10vw, 9rem);
		border-top: 1px solid var(--line-strong);
		border-bottom: 1px solid var(--line-strong);
	}

	.closing-grid > div {
		padding: clamp(2rem, 5vw, 4rem);
	}

	.closing-grid > div + div {
		border-left: 1px solid var(--line);
	}

	.closing-grid h2 {
		margin: 0 0 1rem;
	}

	.closing-grid p:not(.eyebrow) {
		color: var(--ink-soft);
	}

	@media (max-width: 760px) {
		.hero,
		.closing-grid {
			grid-template-columns: 1fr;
		}

		.hero__aside {
			width: min(100%, 15rem);
			justify-self: center;
		}

		.hero {
			gap: 1.5rem;
			padding-block: 2.5rem 3rem;
		}

		.closing-grid > div + div {
			border-top: 1px solid var(--line);
			border-left: 0;
		}
	}
</style>
