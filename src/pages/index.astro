---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import portrait from '../assets/images/portrait/brian-ellsworth-portrait.webp';

const page = await getEntry('pages', 'about');
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
---

<BaseLayout
	description={page?.data.description ?? site.shortBio}
	placeholder={page?.data.placeholder ?? true}
>
	<div class="shell about-grid">
		<header>
			<h1>About</h1>
		</header>
		<aside>
			<Image
				class="about-mark"
				src={portrait}
				alt="Brian Ellsworth smiling, wearing glasses"
				widths={[400, 800, 1200]}
				sizes="(max-width: 760px) 20rem, 30vw"
				loading="eager"
				fetchpriority="high"
			/>
		</aside>
		<div class="prose about-copy">
			{Content ? <Content /> : <p>{site.longBio}</p>}
		</div>
	</div>
</BaseLayout>

<style>
	.about-grid {
		display: grid;
		grid-template-areas:
			'portrait intro'
			'portrait copy';
		grid-template-columns: minmax(17rem, 0.65fr) minmax(0, 1.15fr);
		align-items: start;
		gap: 2rem clamp(3rem, 8vw, 7rem);
		padding-block: clamp(2rem, 3vw, 3rem);
	}

	.about-grid header {
		grid-area: intro;
	}

	.about-grid h1 {
		max-width: 16ch;
		font-size: clamp(2.35rem, 4.5vw, 3.8rem);
	}

	.about-grid aside {
		grid-area: portrait;
		align-self: start;
		justify-self: start;
		width: min(100%, 28rem);
	}

	.about-mark {
		width: 100%;
		aspect-ratio: 4 / 5;
		margin-bottom: 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		object-fit: cover;
	}

	.about-copy {
		grid-area: copy;
		max-width: 68ch;
		margin: 0;
		padding-top: 0;
	}

	:global(.about-copy > h2:first-child) {
		margin-top: 0;
	}

	@media (max-width: 760px) {
		.about-grid {
			grid-template-areas:
				'intro'
				'portrait'
				'copy';
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-block: 3.5rem 4.5rem;
		}

		.about-grid aside {
			justify-self: center;
			width: min(100%, 24rem);
		}
	}
</style>
