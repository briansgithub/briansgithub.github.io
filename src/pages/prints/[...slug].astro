---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import PrintViewer from '../../components/PrintViewer.astro';
import { contentSlug, formatDate, isVisible } from '../../utils/content';

export async function getStaticPaths() {
	const entries = await getCollection('prints', ({ data }) => isVisible(data));
	return entries.map((entry) => ({ params: { slug: contentSlug(entry.id) }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'prints'>;
}
const { entry } = Astro.props;
const { Content } = await render(entry);

const meta = entry.data.printedAt
	? `${entry.data.material} · ${formatDate(entry.data.printedAt)}`
	: entry.data.material;
---

<ContentLayout
	title={entry.data.title}
	description={entry.data.summary}
	meta={meta}
	tags={entry.data.tags}
	placeholder={entry.data.placeholder}
>
	{
		entry.data.links && (
			<nav class="project-links" aria-label="Print links">
				{Object.entries(entry.data.links).map(([label, href]) => (
					<a href={href}>{label} ↗</a>
				))}
			</nav>
		)
	}
	{
		entry.data.model && (
			<PrintViewer file={entry.data.model.file} sizeBytes={entry.data.model.sizeBytes} />
		)
	}
	<Content />
</ContentLayout>

<style>
	.project-links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.25rem;
		margin-bottom: 2.5rem;
		color: var(--accent);
		font-family: var(--sans);
		font-size: 0.82rem;
		font-weight: 500;
	}
</style>
