---
import { getEntry, render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../data/site';
import portrait from '../assets/images/portrait/brian-ellsworth-portrait.webp';

const page = await getEntry('pages', 'about');
const rendered = page ? await render(page) : undefined;
const Content = rendered?.Content;
---

<BaseLayout
	title="About"
	description={page?.data.description ?? site.shortBio}
	placeholder={page?.data.placeholder ?? true}
>
	<div class="shell about-grid">
		<header>
			<p class="eyebrow">About</p>
			<h1>A person behind the notes.</h1>
		</header>
		<aside>
			<Image
				class="about-mark"
				src={portrait}
				alt="Brian Ellsworth smiling, wearing glasses"
				widths={[400, 800, 1200]}
				sizes="(max-width: 760px) 20rem, 30vw"
			/>
		</aside>
		<div class="prose about-copy">
			{Content ? <Content /> : <p>{site.longBio}</p>}
		</div>
	</div>
</BaseLayout>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.45fr) minmax(16rem, 0.55fr);
		gap: 2rem clamp(3rem, 9vw, 9rem);
		padding-block: clamp(4rem, 10vw, 9rem);
	}
	.about-grid h1 {
		max-width: 14ch;
		font-size: clamp(2.2rem, 4.5vw, 3.4rem);
	}
	.about-grid aside {
		align-self: start;
	}
	.about-mark {
		width: 100%;
		aspect-ratio: 4 / 5;
		margin-bottom: 1rem;
		border: 1px solid var(--line);
		border-radius: var(--radius);
		object-fit: cover;
	}
	.about-copy {
		grid-column: 1;
		padding-top: 1rem;
	}
	@media (max-width: 760px) {
		.about-grid {
			grid-template-columns: 1fr;
		}
		.about-grid aside {
			max-width: 20rem;
		}
		.about-copy {
			grid-column: 1;
		}
	}
</style>
