---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import ContentCard from '../../components/ContentCard.astro';
import { contentSlug, formatDate, isVisible } from '../../utils/content';

export async function getStaticPaths() {
	const [writing, projects, books] = await Promise.all([
		getCollection('writing', ({ data }) => isVisible(data)),
		getCollection('projects', ({ data }) => isVisible(data)),
		getCollection('books', ({ data }) => isVisible(data)),
	]);
	const tags = new Set([
		...writing.flatMap((x) => x.data.tags),
		...projects.flatMap((x) => x.data.tags),
		...books.flatMap((x) => x.data.tags),
	]);
	return [...tags].map((tag) => ({ params: { tag }, props: { writing, projects, books } }));
}

const { tag = '' } = Astro.params;
const { writing, projects, books } = Astro.props;
const items = [
	...writing
		.filter((x) => x.data.tags.includes(tag))
		.map((entry) => ({
			href: `/writing/${contentSlug(entry.id)}/`,
			title: entry.data.title,
			description: entry.data.description,
			meta: `Writing · ${formatDate(entry.data.publishedAt)}`,
			tags: entry.data.tags,
			placeholder: entry.data.placeholder,
		})),
	...projects
		.filter((x) => x.data.tags.includes(tag))
		.map((entry) => ({
			href: `/projects/${contentSlug(entry.id)}/`,
			title: entry.data.title,
			description: entry.data.summary,
			meta: `Project · ${entry.data.year}`,
			tags: entry.data.tags,
			placeholder: entry.data.placeholder,
		})),
	...books
		.filter((x) => x.data.tags.includes(tag))
		.map((entry) => ({
			href: `/books/${contentSlug(entry.id)}/`,
			title: entry.data.title,
			description: entry.data.summary,
			meta: `Book note · ${entry.data.author}`,
			tags: entry.data.tags,
			placeholder: entry.data.placeholder,
		})),
];
---

<BaseLayout title={`#${tag}`} description={`Items tagged ${tag}.`}>
	<div class="shell">
		<PageIntro
			eyebrow="Index"
			title={`#${tag}`}
			description={`${items.length} ${items.length === 1 ? 'entry' : 'entries'} across the log.`}
		/>
		<div class="content-grid">{items.map((item) => <ContentCard {...item} />)}</div>
	</div>
</BaseLayout>
