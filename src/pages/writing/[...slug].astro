---
import { getCollection } from 'astro:content';
import { contentSlug, isVisible } from '../../utils/content';

export async function getStaticPaths() {
	const entries = await getCollection('writing', ({ data }) => isVisible(data));
	return entries.map((entry) => ({ params: { slug: contentSlug(entry.id) } }));
}

return Astro.redirect(`/blog/${Astro.params.slug}/`, 301);
---
