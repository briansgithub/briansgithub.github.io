---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageIntro from '../components/PageIntro.astro';
import ActionLinks from '../components/ActionLinks.astro';
import { resume } from '../data/resume';
import { site } from '../data/site';
---

<BaseLayout
	title="Résumé"
	description="Experience, education, and technical practice."
	placeholder={resume.placeholder}
>
	<div class="shell resume-shell">
		<PageIntro
			eyebrow="Curriculum vitae"
			title="Résumé"
			description={resume.summary}
			placeholder={resume.placeholder}
		/>
		<div class="resume-actions">
			<ActionLinks
				label="Résumé links"
				actions={[
					{
						label: 'Download PDF',
						href: '/files/brian-ellsworth-resume.pdf',
						download: true,
						variant: 'primary',
					},
					{ label: 'Email', href: `mailto:${site.email}` },
					{ label: 'GitHub', href: site.github },
				]}
			/>
		</div>
		<section class="resume-section" aria-labelledby="experience-heading">
			<h2 id="experience-heading">Experience</h2>
			<div>
				{
					resume.experience.map((item) => (
						<article class="resume-item">
							<header>
								<>
									<h3>{item.role}</h3>
									<p>{item.organization}</p>
									<span>
										{item.period} · {item.location}
									</span>
								</>
							</header>
							<ul>
								{item.highlights.map((highlight) => (
									<li>{highlight}</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</section>
		<section class="resume-section" aria-labelledby="education-heading">
			<h2 id="education-heading">Education</h2>
			<div>
				{
					resume.education.map((item) => (
						<article class="resume-item">
							<header>
								<>
									<h3>{item.credential}</h3>
									<p>{item.institution}</p>
									<span>{item.period}</span>
								</>
							</header>
							{item.details && <p>{item.details}</p>}
						</article>
					))
				}
			</div>
		</section>
		<section class="resume-section" aria-labelledby="skills-heading">
			<h2 id="skills-heading">Technical practice</h2>
			<div class="skill-grid">
				{
					resume.skills.map((group) => (
						<article>
							<>
								<h3>{group.category}</h3>
								<p>{group.items.join(' · ')}</p>
							</>
						</article>
					))
				}
			</div>
		</section>
	</div>
</BaseLayout>

<style>
	.resume-shell {
		padding-bottom: clamp(4rem, 9vw, 8rem);
	}
	.resume-actions {
		display: flex;
		justify-content: flex-end;
		padding: 1.25rem 0 1.5rem;
		border-bottom: 1px solid var(--line);
	}
	.resume-actions :global(.action-links) {
		justify-content: flex-end;
		margin-top: 0;
	}
	.resume-section {
		display: grid;
		grid-template-columns: minmax(10rem, 0.35fr) minmax(0, 1fr);
		gap: 2rem 5rem;
		padding-block: 3.5rem;
		border-bottom: 1px solid var(--line);
	}
	.resume-section > h2 {
		margin: 0;
		font-size: 1.15rem;
	}
	.resume-item + .resume-item {
		margin-top: 3rem;
		padding-top: 3rem;
		border-top: 1px solid var(--line);
	}
	.resume-item header {
		display: grid;
		grid-template-columns: 1fr auto;
		gap: 0.2rem 1.5rem;
	}
	.resume-item h3,
	.skill-grid h3 {
		margin: 0;
		font-family: var(--sans);
		font-size: 1.2rem;
		font-weight: 500;
	}
	.resume-item header p,
	.resume-item header span {
		margin: 0;
		color: var(--ink-soft);
		font-size: 0.82rem;
	}
	.resume-item header span {
		grid-column: 2;
		grid-row: 1 / span 2;
		text-align: right;
	}
	.skill-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr));
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}
	.skill-grid article {
		padding: 1.25rem;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
	}
	.skill-grid p {
		margin-bottom: 0;
		color: var(--ink-soft);
	}
	@media (max-width: 720px) {
		.resume-section {
			grid-template-columns: 1fr;
		}
		.resume-item header {
			display: block;
		}
		.resume-item header span {
			display: block;
			margin-top: 0.25rem;
			text-align: left;
		}
		.resume-actions,
		.resume-actions :global(.action-links) {
			justify-content: flex-start;
		}
	}
</style>
