---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { contentSlug, isVisible, projectPageLinks } from '../../utils/content';

export async function getStaticPaths() {
	const entries = await getCollection('projects', ({ data }) => isVisible(data));
	return entries.map((entry) => ({ params: { slug: contentSlug(entry.id) }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'projects'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const links = projectPageLinks(entry.data.links);
---

<ContentLayout
	title={entry.data.title}
	description={entry.data.summary}
	meta={`${entry.data.year} · ${entry.data.status}`}
	tags={entry.data.tags}
	placeholder={entry.data.placeholder}
	headings={headings}
	collectionHref="/projects/"
	collectionLabel="Projects"
	links={links}
>
	<Content />
</ContentLayout>
