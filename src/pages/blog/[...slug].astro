---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import ContentLayout from '../../layouts/ContentLayout.astro';
import { contentSlug, formatDate, isVisible } from '../../utils/content';

export async function getStaticPaths() {
	const entries = await getCollection('writing', ({ data }) => isVisible(data));
	return entries.map((entry) => ({ params: { slug: contentSlug(entry.id) }, props: { entry } }));
}

interface Props {
	entry: CollectionEntry<'writing'>;
}
const { entry } = Astro.props;
const { Content, headings } = await render(entry);
---

<ContentLayout
	title={entry.data.title}
	description={entry.data.description}
	meta={formatDate(entry.data.publishedAt)}
	tags={entry.data.tags}
	placeholder={entry.data.placeholder}
	headings={headings}
	collectionHref="/blog/"
	collectionLabel="Blog"
>
	<Content />
</ContentLayout>
