---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import { isVisible } from '../../utils/content';

const quotes = (await getCollection('quotes', ({ data }) => isVisible(data))).sort(
	(a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);
---

<BaseLayout title="Quotations" description="Lines worth returning to.">
	<div class="shell">
		<PageIntro
			eyebrow="Index 04"
			title="Quotations"
			description="Lines worth returning to—kept with their source whenever I can find it."
		/>
		<div class="quotes-list">
			{
				quotes.map((entry, index) => (
					<figure>
						<div class="quote-number">{String(index + 1).padStart(2, '0')}</div>
						<blockquote>“{entry.data.quote}”</blockquote>
						<figcaption>
							<span>
								— {entry.data.author}
								{entry.data.source ? `, ${entry.data.source}` : ''}
							</span>
							{entry.data.placeholder && <PlaceholderBadge label="Sample selection" />}
						</figcaption>
					</figure>
				))
			}
			{quotes.length === 0 && <p class="empty-state">No quotations published yet.</p>}
		</div>
	</div>
</BaseLayout>

<style>
	.quotes-list {
		margin-bottom: clamp(4rem, 9vw, 8rem);
		border-top: 1px solid var(--line);
	}

	figure {
		display: grid;
		grid-template-columns: 4rem minmax(0, 1fr);
		gap: 1rem 2rem;
		margin: 0;
		padding: clamp(2rem, 6vw, 5rem) 0;
		border-bottom: 1px solid var(--line);
	}

	.quote-number {
		color: var(--accent-violet);
		font-family: var(--mono);
		font-size: 0.7rem;
	}

	blockquote {
		max-width: 34ch;
		margin: 0;
		font-family: var(--sans);
		font-size: clamp(1.4rem, 2.6vw, 2.2rem);
		font-weight: 500;
		line-height: 1.35;
		letter-spacing: -0.015em;
	}

	figcaption {
		display: flex;
		grid-column: 2;
		align-items: center;
		gap: 0.8rem;
		color: var(--ink-soft);
		font-size: 0.82rem;
	}

	@media (max-width: 560px) {
		figure {
			grid-template-columns: 1fr;
		}

		figcaption {
			grid-column: 1;
			flex-wrap: wrap;
		}
	}
</style>
