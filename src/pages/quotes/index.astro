---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import { isVisible } from '../../utils/content';

const quotes = (await getCollection('quotes', ({ data }) => isVisible(data))).sort(
	(a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

function formatCategoryLabel(category: string) {
	return category
		.replace(/^On\s+/i, '')
		.replace(/(?:\.\.\.|…)+$/, '')
		.trim();
}

function categorySlug(category: string) {
	return formatCategoryLabel(category)
		.toLowerCase()
		.replace(/[^a-z0-9]+/g, '-')
		.replace(/(^-|-$)/g, '');
}

type QuoteItem = {
	entry: (typeof quotes)[number];
	number: number;
	citationText: string | null;
	citationHref: string | null;
};

type Category = {
	id: string;
	label: string;
	quotes: QuoteItem[];
};

const categories: Category[] = [];
const categoriesByLabel = new Map<string, Category>();
const usedCategoryIds = new Set<string>();

quotes.forEach((entry, index) => {
	const sourceLabel = entry.data.category ?? 'Uncategorized';
	let category = categoriesByLabel.get(sourceLabel);
	if (!category) {
		const baseId = `category-${categorySlug(sourceLabel) || 'uncategorized'}`;
		let id = baseId;
		let suffix = 2;
		while (usedCategoryIds.has(id)) {
			id = `${baseId}-${suffix}`;
			suffix += 1;
		}
		category = { id, label: formatCategoryLabel(sourceLabel), quotes: [] };
		categoriesByLabel.set(sourceLabel, category);
		usedCategoryIds.add(id);
		categories.push(category);
	}

	// The original page hyperlinked the citation text itself (a title when there
	// was one, otherwise the bare URL) â€” retain that behavior for every quote.
	category.quotes.push({
		entry,
		number: index + 1,
		citationText: entry.data.source ?? entry.data.url ?? null,
		citationHref: entry.data.url ?? null,
	});
});
---

<BaseLayout title="Quotations" description="Lines worth returning to.">
	<div class="shell">
		<PageIntro
			eyebrow="Collection 03"
			title="Quotations"
			description="Lines worth returning to—kept with their source whenever I can find it."
		/>
		{
			categories.length > 0 && (
				<nav id="quote-categories" class="quote-jump-grid" aria-label="Quote categories">
					{categories.map((category) => (
						<a href={`#${category.id}`}>
							<span>{category.label}</span>
							<span class="quote-jump-grid__count">{category.quotes.length}</span>
						</a>
					))}
				</nav>
			)
		}
		<div class="quotes-list">
			{
				categories.map((category) => (
					<section
						id={category.id}
						class="quote-category-section"
						aria-labelledby={`${category.id}-heading`}
					>
						<header class="quote-category-header">
							<h2 id={`${category.id}-heading`} class="quote-category">
								{category.label}
							</h2>
							<span class="quote-category__count">{category.quotes.length} quotes</span>
						</header>
						{category.quotes.map((item) => (
							<figure>
								<div class="quote-number">{String(item.number).padStart(2, '0')}</div>
								<blockquote>“{item.entry.data.quote}”</blockquote>
								<figcaption>
									<span>
										— {item.entry.data.author}
										{item.citationText && ', '}
										{item.citationText &&
											(item.citationHref ? (
												<a href={item.citationHref} target="_blank" rel="noopener noreferrer">
													{item.citationText}
												</a>
											) : (
												item.citationText
											))}
									</span>
									{item.entry.data.placeholder && <PlaceholderBadge label="Sample selection" />}
								</figcaption>
							</figure>
						))}
						<a class="quote-category__back" href="#quote-categories">
							Back to categories ↑
						</a>
					</section>
				))
			}
			{quotes.length === 0 && <p class="empty-state">No quotations published yet.</p>}
		</div>
	</div>
</BaseLayout>

<style>
	.quote-jump-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
		margin-top: clamp(2rem, 4vw, 3rem);
		border-top: 1px solid var(--line);
		border-left: 1px solid var(--line);
	}

	.quote-jump-grid a {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		min-height: 3rem;
		padding: 0.65rem 0.85rem;
		border-right: 1px solid var(--line);
		border-bottom: 1px solid var(--line);
		color: var(--ink-soft);
		font-family: var(--mono);
		font-size: 0.7rem;
		letter-spacing: 0.03em;
		text-decoration: none;
	}

	.quote-jump-grid a:hover {
		background: color-mix(in srgb, var(--accent) 8%, var(--surface));
		color: var(--accent);
	}

	.quote-jump-grid__count,
	.quote-category__count {
		color: var(--accent-violet);
		font-family: var(--mono);
		font-size: 0.68rem;
		letter-spacing: 0.04em;
		white-space: nowrap;
	}

	.quotes-list {
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
	}

	.quote-category-section {
		scroll-margin-top: 7rem;
		border-top: 1px solid var(--line);
	}

	.quote-category-header {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		gap: 1rem;
		padding: clamp(1.75rem, 3.5vw, 2.5rem) 0 0.6rem;
	}

	.quote-category {
		display: flex;
		flex: 1;
		align-items: baseline;
		gap: 0.9rem;
		margin: 0;
		color: var(--accent);
		font-family: var(--mono);
		font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.quote-category::after {
		align-self: center;
		flex: 1;
		height: 1px;
		background: var(--line-strong);
		content: '';
	}

	figure {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		align-items: baseline;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
	}

	.quote-number {
		color: var(--accent-violet);
		font-family: var(--mono);
		font-size: 0.68rem;
		line-height: 1;
	}

	blockquote {
		max-width: 62ch;
		margin: 0;
		font-family: var(--sans);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.5;
		white-space: pre-line;
		text-wrap: pretty;
	}

	figcaption {
		display: flex;
		grid-column: 2;
		align-items: baseline;
		gap: 0.8rem;
		max-width: 62ch;
		margin-top: 0.35rem;
		color: var(--ink-soft);
		font-size: 0.78rem;
		line-height: 1.4;
	}

	figcaption a {
		color: var(--ink-soft);
		text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
	}

	figcaption a:hover {
		color: var(--accent-soft);
	}

	.quote-category__back {
		display: inline-flex;
		align-items: center;
		min-height: 2.75rem;
		margin-top: 0.5rem;
		color: var(--accent);
		font-size: 0.78rem;
		font-weight: 500;
	}

	@media (max-width: 560px) {
		.quote-category-header {
			align-items: flex-start;
			flex-direction: column;
			gap: 0.4rem;
		}

		.quote-category {
			width: 100%;
		}

		figure {
			grid-template-columns: 1fr;
			gap: 0.35rem;
			padding: 0.9rem 0;
		}

		figcaption {
			grid-column: 1;
			flex-wrap: wrap;
		}
	}
</style>
