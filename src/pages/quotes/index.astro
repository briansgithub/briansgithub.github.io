---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageIntro from '../../components/PageIntro.astro';
import PlaceholderBadge from '../../components/PlaceholderBadge.astro';
import { isVisible } from '../../utils/content';

const quotes = (await getCollection('quotes', ({ data }) => isVisible(data))).sort(
	(a, b) => (a.data.order ?? 999) - (b.data.order ?? 999),
);

const items = [];
let lastCategory;
quotes.forEach((entry, index) => {
	if (entry.data.category && entry.data.category !== lastCategory) {
		items.push({ kind: 'category', label: entry.data.category });
		lastCategory = entry.data.category;
	}
	// The original page hyperlinked the citation text itself (a title when
	// there was one, otherwise the bare URL) — preserve that here rather
	// than dropping the link when there's no separate source title.
	const citationText = entry.data.source ?? entry.data.url ?? null;
	const citationHref = entry.data.url ?? null;
	items.push({ kind: 'quote', entry, number: index + 1, citationText, citationHref });
});
---

<BaseLayout title="Quotations" description="Lines worth returning to.">
	<div class="shell">
		<PageIntro
			eyebrow="Index 04"
			title="Quotations"
			description="Lines worth returning to—kept with their source whenever I can find it."
		/>
		<div class="quotes-list">
			{
				items.map((item) =>
					item.kind === 'category' ? (
						<h2 class="quote-category">{item.label}</h2>
					) : (
						<figure>
							<div class="quote-number">{String(item.number).padStart(2, '0')}</div>
							<blockquote>“{item.entry.data.quote}”</blockquote>
							<figcaption>
								<span>
									— {item.entry.data.author}
									{item.citationText && ', '}
									{item.citationText &&
										(item.citationHref ? (
											<a href={item.citationHref} target="_blank" rel="noopener noreferrer">
												{item.citationText}
											</a>
										) : (
											item.citationText
										))}
								</span>
								{item.entry.data.placeholder && <PlaceholderBadge label="Sample selection" />}
							</figcaption>
						</figure>
					),
				)
			}
			{quotes.length === 0 && <p class="empty-state">No quotations published yet.</p>}
		</div>
	</div>
</BaseLayout>

<style>
	.quotes-list {
		margin-bottom: clamp(2.5rem, 5vw, 4rem);
		border-top: 1px solid var(--line);
	}

	/* Section marker: label plus a trailing rule. Sized clearly above the
	   quote text below it so it reads as a heading, not a footnote. */
	.quote-category {
		display: flex;
		align-items: baseline;
		gap: 0.9rem;
		margin: 0;
		padding: clamp(1.75rem, 3.5vw, 2.5rem) 0 0.6rem;
		color: var(--accent);
		font-family: var(--mono);
		font-size: clamp(1.05rem, 0.95rem + 0.5vw, 1.3rem);
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
	}

	.quote-category::after {
		align-self: center;
		flex: 1;
		height: 1px;
		background: var(--line-strong);
		content: '';
	}

	/* The list already opens with a hairline, so the first marker sits tighter. */
	.quote-category:first-child {
		padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
	}

	figure {
		display: grid;
		grid-template-columns: 2.25rem minmax(0, 1fr);
		/* Sits the numeral on the quote's first baseline at every font size. */
		align-items: baseline;
		gap: 0.5rem 1rem;
		margin: 0;
		padding: 1.1rem 0;
		border-bottom: 1px solid var(--line);
	}

	.quote-number {
		color: var(--accent-violet);
		font-family: var(--mono);
		font-size: 0.68rem;
		line-height: 1;
	}

	/* Quotes here range from six words to a 600-character passage, so this is
	   sized as reading text, not as a pull quote — and kept below the
	   category heading's size so the two don't compete. */
	blockquote {
		max-width: 62ch;
		margin: 0;
		font-family: var(--sans);
		font-size: 1rem;
		font-weight: 400;
		line-height: 1.5;
		white-space: pre-line;
		text-wrap: pretty;
	}

	figcaption {
		display: flex;
		grid-column: 2;
		align-items: baseline;
		gap: 0.8rem;
		max-width: 62ch;
		margin-top: 0.35rem;
		color: var(--ink-soft);
		font-size: 0.78rem;
		line-height: 1.4;
	}

	figcaption a {
		color: var(--ink-soft);
		text-decoration-color: color-mix(in srgb, currentColor 55%, transparent);
	}

	figcaption a:hover {
		color: var(--accent-soft);
	}

	@media (max-width: 560px) {
		.quote-category {
			padding-top: 1.5rem;
		}

		figure {
			grid-template-columns: 1fr;
			gap: 0.35rem;
			padding: 0.9rem 0;
		}

		figcaption {
			grid-column: 1;
			flex-wrap: wrap;
		}
	}
</style>
