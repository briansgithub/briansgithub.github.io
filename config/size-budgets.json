{
	"version": 1,
	"units": "bytes",
	"distDirectory": "dist",
	"source": {
		"warningTotalBytes": 104857600,
		"maximumTotalBytes": 262144000,
		"maximumFileBytes": 5242880,
		"warningImageBytes": 1048576,
		"maximumImageBytes": 2097152,
		"warningDocumentBytes": 2097152,
		"maximumDocumentBytes": 3145728
	},
	"dist": {
		"warningTotalBytes": 104857600,
		"maximumTotalBytes": 262144000,
		"maximumFileBytes": 5242880,
		"warningImageBytes": 512000,
		"maximumImageBytes": 1048576,
		"warningHtmlBytes": 153600,
		"maximumHtmlBytes": 256000,
		"warningScriptStyleBytes": 204800,
		"maximumScriptStyleBytes": 307200,
		"maximumDocumentBytes": 3145728
	},
	"extensions": {
		"images": [".avif", ".gif", ".jpeg", ".jpg", ".png", ".svg", ".webp"],
		"documents": [".pdf"],
		"html": [".htm", ".html"],
		"scriptsAndStyles": [".css", ".js", ".mjs"],
		"forbidden": {
			"camera/raw or editing-source image": [
				".3fr",
				".ai",
				".ari",
				".arw",
				".bay",
				".cr2",
				".cr3",
				".crw",
				".dcr",
				".dng",
				".erf",
				".fff",
				".heic",
				".heif",
				".iiq",
				".kdc",
				".mef",
				".mos",
				".mrw",
				".nef",
				".nrw",
				".orf",
				".pef",
				".psb",
				".psd",
				".raf",
				".raw",
				".rw2",
				".rwl",
				".sr2",
				".srf",
				".srw",
				".tif",
				".tiff",
				".x3f"
			],
			"video or audio": [
				".3gp",
				".aac",
				".aiff",
				".alac",
				".avi",
				".flac",
				".flv",
				".m4a",
				".m4v",
				".mkv",
				".mov",
				".mp3",
				".mp4",
				".mpeg",
				".mpg",
				".oga",
				".ogg",
				".ogv",
				".opus",
				".wav",
				".webm",
				".wma",
				".wmv"
			],
			"archive or disk image": [
				".7z",
				".bz2",
				".cab",
				".dmg",
				".gz",
				".iso",
				".rar",
				".tar",
				".tgz",
				".xz",
				".zip",
				".zst"
			]
		}
	},
	"inlineDataUriPattern": "data:(?:image|audio|video)/",
	"textInspectionExtensions": [
		".astro",
		".css",
		".htm",
		".html",
		".js",
		".json",
		".jsx",
		".md",
		".mdx",
		".mjs",
		".ts",
		".tsx"
	],
	"sourceIgnoreDirectories": [
		".astro",
		".git",
		".obsidian/cache",
		"dist",
		"media-inbox",
		"media-originals",
		"node_modules"
	]
}
