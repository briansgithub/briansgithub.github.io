* text=auto

# Scripts and configuration must stay LF-terminated for GitHub Actions and Git hooks.
*.mjs text eol=lf
*.js text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf
*.mdx text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
.githooks/* text eol=lf

# Do not perform line-ending conversion on binary assets.
*.avif binary
*.gif binary
*.ico binary
*.jpeg binary
*.jpg binary
*.pdf binary
*.png binary
*.webp binary
*.woff binary
*.woff2 binary
